# =============================================================================
# BioSecure AI — Git Ignore Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Secrets, Credentials & Local Configuration (Never commit credentials)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
cookies.txt
token.json
secrets.json
credentials.json
serviceAccountKey*.json
client_secret*.json

# -----------------------------------------------------------------------------
# 2. Biometric Data, Databases & Student PII
# -----------------------------------------------------------------------------
known_faces/
known_faces/*
!known_faces/.gitkeep
EncodeFile_Insight.npy
EncodeFile_Insight_names.json
EncodeFile_Insight.pkl
*.npy
*.npz
database.db
*.db
*.sqlite
*.sqlite3
data.csv
IDF/

# -----------------------------------------------------------------------------
# 3. Python Bytecode, Virtual Environments & Packaging
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.installed.cfg

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
